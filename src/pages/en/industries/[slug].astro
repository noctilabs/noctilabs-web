---
import type { GetStaticPaths } from 'astro';
import IndustriaPage from '../../../components/sections/industria/IndustriaPage.astro';
import { INDUSTRY_SLUGS, type IndustryId } from '../../../i18n/routes';

export const getStaticPaths = (() =>
  (Object.keys(INDUSTRY_SLUGS) as IndustryId[]).map((industry) => ({
    params: { slug: INDUSTRY_SLUGS[industry].en },
    props: { industry },
  }))) satisfies GetStaticPaths;

const { industry } = Astro.props;
---
<IndustriaPage locale="en" industry={industry} />
