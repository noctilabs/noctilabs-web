---
import Base from '../layouts/Base.astro';
import { href } from '../i18n/routes';
import { ui } from '../i18n/ui';

// Excepción del spec 001 §3.7: una sola página bilingüe, sin canonical, hreflang ni selector.
const { es, en } = ui;
---
<Base locale="es" page={null} title={`${es.notFound.title} · ${en.notFound.title} — NoctiLabs`} description={`${es.notFound.body} ${en.notFound.body}`}>
  <section class="nf">
    <div>
      <h1>{es.notFound.title}</h1>
      <p>{es.notFound.body}</p>
      <a href={href({ id: 'home' }, 'es')}>{es.notFound.home}</a>
    </div>
    <div lang="en">
      <h2>{en.notFound.title}</h2>
      <p>{en.notFound.body}</p>
      <a href={href({ id: 'home' }, 'en')} hreflang="en">{en.notFound.home}</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(32.8px, 4.9vw, 72.2px) var(--edge);
    display: grid;
    gap: 48px;
  }
  h1, h2 {
    margin: 0;
    font-size: var(--h2);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -.03em;
  }
  p { margin: 12px 0 16px; color: var(--muted); }
</style>
