---
import '@fontsource-variable/inter';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '../styles/global.css';
import geistMono400 from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { alternates, type Locale, type PageRef } from '../i18n/routes';
import { jsonLdText, OG_LOCALE, ogImage, structuredData, type ArticleLd } from '../lib/seo';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** null en la 404: sin canonical ni hreflang (spec 001 §3.7). */
  page: PageRef | null;
  /** Solo en los artículos: H1 y fecha para el JSON-LD (spec 004 §2.5). */
  article?: ArticleLd;
}
const { locale, title, description, page, article } = Astro.props;
const alt = page ? alternates(page) : null;
const other: Locale = locale === 'es' ? 'en' : 'es';
const ld = page ? structuredData(page, locale, article) : [];
// Spec 004 §2.1: las previews de Vercel (VERCEL_ENV definido y distinto de production) no se indexan.
const vercelEnv = process.env.VERCEL_ENV;
const noindex = !page || (vercelEnv !== undefined && vercelEnv !== 'production');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {alt && <link rel="canonical" href={alt[locale]} />}
    {alt && <link rel="alternate" hreflang="es" href={alt.es} />}
    {alt && <link rel="alternate" hreflang="en" href={alt.en} />}
    {alt && <link rel="alternate" hreflang="x-default" href={alt['x-default']} />}
    {noindex && <meta name="robots" content="noindex" />}
    {alt && page && (
      <>
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:url" content={alt[locale]} />
        <meta property="og:type" content={page.id === 'articulo' ? 'article' : 'website'} />
        <meta property="og:image" content={ogImage(locale)} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:site_name" content="NoctiLabs" />
        <meta property="og:locale" content={OG_LOCALE[locale]} />
        <meta property="og:locale:alternate" content={OG_LOCALE[other]} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {ld.map((d) => <script type="application/ld+json" set:html={jsonLdText(d)} />)}
    <meta name="theme-color" content="#F4F4F2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono400} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Header locale={locale} page={page} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} page={page} />
  </body>
</html>
