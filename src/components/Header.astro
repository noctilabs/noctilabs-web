---
import LangSwitch from './LangSwitch.astro';
import { href, INDUSTRY_SLUGS, pageFromPath, type IndustryId, type Locale } from '../i18n/routes';
import { PRODUCT_SECTION_IDS, ui } from '../i18n/ui';
import { industries } from '../content/industries';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const current = pageFromPath(Astro.url.pathname);
const currentPath = current ? href(current.page, current.locale) : null;
const section = current?.page.id;

const productItems = PRODUCT_SECTION_IDS.map((id) => ({
  label: t.productSections[id].label,
  desc: t.productSections[id].desc,
  href: href({ id: 'producto' }, locale, id),
}));
const industryItems = (Object.keys(INDUSTRY_SLUGS) as IndustryId[]).map((industry) => ({
  label: industries[industry][locale].label,
  desc: industries[industry][locale].blurb,
  href: href({ id: 'industria', industry }, locale),
}));

type Panel = 'producto' | 'industrias';
const nav: { label: string; href: string; active: boolean; panel?: Panel }[] = [
  { label: t.nav.producto, href: href({ id: 'producto' }, locale), active: section === 'producto', panel: 'producto' },
  { label: t.nav.industrias, href: href({ id: 'industria', industry: 'retail' }, locale), active: section === 'industria', panel: 'industrias' },
  { label: t.nav.nosotros, href: href({ id: 'nosotros' }, locale), active: section === 'nosotros' },
  { label: t.nav.insights, href: href({ id: 'insights' }, locale), active: section === 'insights' },
];
const panels: { id: Panel; kicker: string; items: typeof productItems }[] = [
  { id: 'producto', kicker: t.nav.producto, items: productItems },
  { id: 'industrias', kicker: t.nav.industrias, items: industryItems },
];
const mobileGroups = [
  { label: t.nav.producto, href: href({ id: 'producto' }, locale), items: productItems },
  { label: t.nav.industrias, href: href({ id: 'industria', industry: 'retail' }, locale), items: industryItems },
  { label: t.nav.nosotros, href: href({ id: 'nosotros' }, locale), items: [] },
  { label: t.nav.insights, href: href({ id: 'insights' }, locale), items: [] },
];
const MENU_OPEN = 'M4 8h16M4 16h16';
---
<a class="skip" href="#contenido">{t.nav.skip}</a>
<header class="site-header" data-header>
  <div class="capsule" data-capsule>
    <div class="row">
      <a class="logo" href={href({ id: 'home' }, locale)} translate="no" data-logo>NoctiLabs</a>
      <nav class="desk" aria-label={t.nav.label}>
        <ul>
          {nav.map((item) => (
            <li data-group={item.panel}>
              <a
                class="navlink"
                href={item.href}
                data-active={item.active ? '' : undefined}
                aria-current={item.href === currentPath ? 'page' : undefined}
              >{item.label}</a>
              {item.panel && (
                <button
                  type="button"
                  class="chev"
                  aria-expanded="false"
                  aria-controls={`mega-${item.panel}`}
                  aria-label={t.nav.openPanel[item.panel]}
                  data-toggle={item.panel}
                >
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <a class="cta desk" href={href({ id: 'hablemos' }, locale)}>{t.nav.cta}</a>
      <button
        type="button"
        class="burger"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label={t.nav.openMenu}
        data-burger
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={MENU_OPEN} data-burger-icon /></svg>
      </button>
    </div>
    <div class="mpanel" id="menu-mobile" hidden data-mpanel>
      {mobileGroups.map((group) => (
        <div class="mgroup">
          <a class="mlabel" href={group.href}>{group.label}</a>
          {group.items.map((item) => <a class="mitem" href={item.href}>{item.label}</a>)}
        </div>
      ))}
      <a class="mcta" href={href({ id: 'hablemos' }, locale)}>{t.nav.cta}</a>
      <div class="mlang"><LangSwitch /></div>
    </div>
  </div>
  {panels.map((panel) => (
    <div class="mega" id={`mega-${panel.id}`} hidden data-panel={panel.id}>
      <div class="surface">
        <span class="kicker">{panel.kicker}</span>
        <div class="grid">
          {panel.items.map((item) => (
            <a class="mega-item" href={item.href}><span class="mega-label">{item.label}</span><span class="mega-desc">{item.desc}</span></a>
          ))}
        </div>
      </div>
    </div>
  ))}
</header>

<script>
  import { initHeader } from '../scripts/header';
  initHeader();
</script>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 40;
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
  }
  .skip:focus-visible { top: 12px; color: var(--white); }

  .site-header { position: sticky; top: 0; z-index: 30; height: 76px; }

  .capsule {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100% - 2 * var(--edge));
    background: var(--glass);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    border-radius: var(--radius-capsule);
    color: var(--ink);
    overflow: hidden;
  }
  .row {
    height: 56px;
    padding: 0 10px 0 28px;
    display: flex;
    align-items: center;
    gap: clamp(23px, 2.6vw, 42.6px);
  }
  .logo {
    flex: none;
    font-weight: 600;
    font-size: 21px;
    letter-spacing: -.045em;
    white-space: nowrap;
    color: inherit;
    text-decoration: none;
  }
  .logo:hover { color: inherit; }

  .desk { display: none; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: clamp(14.8px, 1.6vw, 24.6px); }
  li { display: flex; align-items: center; }
  .navlink {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: .01em;
    text-transform: uppercase;
    white-space: nowrap;
    height: 56px;
    display: flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
    opacity: .82;
    transition: opacity .15s ease;
  }
  .navlink:hover, .navlink[data-active] { color: inherit; opacity: 1; }
  .chev {
    all: unset;
    width: 24px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: .82;
  }
  .chev:hover, .chev[aria-expanded='true'] { opacity: 1; }
  .chev:focus-visible { outline: 2px solid var(--blue-link); outline-offset: -8px; border-radius: 8px; }
  .chev[aria-expanded='true'] svg { transform: rotate(180deg); }
  .cta {
    flex: none;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .01em;
    padding: 9px 16px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    white-space: nowrap;
    text-decoration: none;
    transition: background-color .15s ease;
  }
  .cta:hover { background: var(--ink-hover); color: var(--white); }

  .burger {
    all: unset;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .burger:focus-visible { outline: 2px solid var(--blue-link); outline-offset: -4px; border-radius: 12px; }

  .mpanel {
    margin: 0 18px;
    border-top: 1px solid rgba(11, 11, 12, .14);
    padding: 8px 0 18px;
    max-height: calc(100dvh - 110px);
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
  }
  .mpanel[hidden] { display: none; }
  .mgroup { display: flex; flex-direction: column; padding: 12px 0; border-bottom: 1px solid rgba(11, 11, 12, .1); }
  .mlabel, .mitem { font-family: var(--font-mono); color: inherit; text-decoration: none; }
  .mlabel { font-size: 15px; text-transform: uppercase; padding: 4px 0; }
  .mitem { font-size: 14px; padding: 6px 0; color: var(--body-3); }
  .mlabel:hover, .mitem:hover { color: var(--blue-link); }
  .mcta {
    margin-top: 16px;
    padding: 14px 20px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    font-family: var(--font-mono);
    font-size: 14px;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
  }
  .mcta:hover { background: var(--ink-hover); color: var(--white); }
  .mlang { margin-top: 16px; display: flex; justify-content: center; font-family: var(--font-mono); font-size: 13px; }

  .mega {
    position: absolute;
    top: 66px;
    left: 50%;
    transform: translateX(-50%);
    width: min(760px, calc(100% - 2 * var(--edge)));
    padding-top: 8px;
    display: none;
  }
  .surface {
    background: var(--glass);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    border-radius: var(--radius-capsule);
    color: var(--ink);
    padding: 22px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .kicker { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .02em; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 40px; }
  .mega-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-mono);
    color: inherit;
    text-decoration: none;
    transition: opacity .15s ease;
  }
  .mega-item:hover { color: inherit; opacity: .65; }
  .mega-label { font-size: 14px; font-weight: 500; }
  .mega-desc { font-size: 13px; line-height: 1.4; color: var(--body-3); }

  @media (min-width: 1000px) {
    .desk { display: flex; }
    nav.desk { display: block; }
    .burger, .mpanel { display: none; }
    .mpanel:not([hidden]) { display: none; }
    .mega:not([hidden]) { display: block; }
  }
</style>
