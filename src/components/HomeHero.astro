---
// Hero provisorio del home (enmienda al spec 001 §3.7): video a sangre + degradado del dueño.
// El contenido definitivo del hero se especifica en la fase 2.
interface Props {
  title: string;
  lead: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
}
const { title, lead, primary, secondary } = Astro.props;
---
<section class="hero">
  {/* Póster por <picture> (el atributo poster no admite media): el vertical solo se baja en mobile. El video, sin poster, es transparente hasta su primer cuadro. */}
  <picture class="poster" aria-hidden="true">
    <source media="(max-width: 767px)" srcset="/media/hero-vertical-poster.webp" width="608" height="1080" />
    <img src="/media/hero-poster.webp" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
  </picture>
  <video class="media" autoplay muted loop playsinline preload="metadata" width="1920" height="1080" aria-hidden="true">
    <source src="/media/hero-vertical-av1.mp4" media="(max-width: 767px)" type='video/mp4; codecs="av01.0.04M.10"' />
    <source src="/media/hero-vertical-h264.mp4" media="(max-width: 767px)" type='video/mp4; codecs="avc1.640028"' />
    <source src="/media/hero-av1.mp4" type='video/mp4; codecs="av01.0.08M.10"' />
    <source src="/media/hero-h264.mp4" type='video/mp4; codecs="avc1.640028"' />
  </video>
  <div class="veil"></div>
  <div class="copy">
    <h1>{title}</h1>
    <div class="side">
      <p>{lead}</p>
      <div class="ctas">
        <a class="cta cta-solid" href={primary.href}>{primary.label}</a>
        <a class="cta cta-ghost" href={secondary.href}>{secondary.label}</a>
      </div>
    </div>
  </div>
</section>

<script>
  // El video se detiene con prefers-reduced-motion. Sin botón de pausa: decisión del dueño (2026-10-04).
  // Script procesado (spec 004 §2.8): Astro lo cubre con su hash en la CSP; un is:inline no lo estaría.
  (() => {
    const v = document.querySelector<HTMLVideoElement>('.hero .media');
    if (!v) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const respect = () => { if (reduce.matches) { v.removeAttribute('autoplay'); v.pause(); } };
    respect();
    reduce.addEventListener('change', respect);
  })();
</script>

<style>
  .hero {
    position: relative;
    margin-top: -76px;
    height: max(680px, 100vh);
    overflow: hidden;
    background: var(--ink-hover);
    color: var(--white);
  }
  /* Dueño 2026-10-04: en mobile el hero ocupa exactamente la pantalla visible. `svh` es el alto con las barras del
     navegador visibles: no queda tapado por la barra de dirección ni salta al scrollear (dvh sí). */
  @media (max-width: 999px) {
    .hero { height: 100vh; height: 100svh; }
  }
  .poster { position: absolute; inset: 0; display: block; }
  .poster img, .media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Con reduced motion el video no se pinta: queda el póster (que es su primer cuadro). */
  @media (prefers-reduced-motion: reduce) { .media { visibility: hidden; } }
  .veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(#00000026 0%, #0000001a 13.1179% 60%, #0000004d 100%);
  }
  .copy {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0 clamp(20px, 4vw, 72px) clamp(32.8px, 4.9vw, 72.2px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px 64px;
    align-items: flex-end;
    justify-content: space-between;
  }
  h1 {
    flex: 0 1 auto;
    margin: 0;
    font-size: var(--hero-h1);
    font-weight: 400;
    line-height: 1.025;
    letter-spacing: -.045em;
    max-width: 11ch;
  }
  .side {
    flex: 0 1 440px;
    margin-left: auto;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  p {
    margin: 0;
    font-size: clamp(16px, 1.3vw, 18.9px);
    line-height: 1.35;
    letter-spacing: -.01em;
  }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta {
    /* Dueño 2026-10-04: 5 % más chicos que el diseño (17/30 px de padding y 16 px de texto). */
    padding: 16.15px 28.5px;
    border-radius: var(--radius-pill);
    font-size: 15.2px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color .15s ease;
  }
  .cta-solid { background: var(--white); color: var(--ink); }
  .cta-solid:hover { background: var(--surface-3); color: var(--ink); }
  .cta-ghost { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .7); color: var(--white); }
  .cta-ghost:hover { background: rgba(255, 255, 255, .12); color: var(--white); }
  .cta:focus-visible { outline-color: var(--white); }
</style>
