---
// Hero provisorio del home (enmienda al spec 001 §3.7): video a sangre + degradado del dueño.
// El contenido definitivo del hero se especifica en la fase 2.
interface Props {
  title: string;
  lead: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
  pauseLabel: string;
  playLabel: string;
}
const { title, lead, primary, secondary, pauseLabel, playLabel } = Astro.props;
---
<section class="hero">
  <video class="media" autoplay muted loop playsinline preload="auto" poster="/media/hero-poster.jpg" width="1920" height="1080" aria-hidden="true">
    <source src="/media/hero.webm" type="video/webm" />
    <source src="/media/hero.mp4" type="video/mp4" />
  </video>
  <div class="veil"></div>
  <button type="button" class="toggle" aria-label={pauseLabel} data-pause={pauseLabel} data-play={playLabel}>
    <svg class="i-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 2.5v9M10 2.5v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    <svg class="i-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 2.5l8 4.5-8 4.5z" fill="currentColor" /></svg>
  </button>
  <div class="copy">
    <h1>{title}</h1>
    <div class="side">
      <p>{lead}</p>
      <div class="ctas">
        <a class="cta cta-solid" href={primary.href}>{primary.label}</a>
        <a class="cta cta-ghost" href={secondary.href}>{secondary.label}</a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Guidelines/WCAG 2.2.2: el loop se puede pausar y se detiene con prefers-reduced-motion.
  (() => {
    const v = document.querySelector('.hero .media');
    const b = document.querySelector('.hero .toggle');
    if (!v || !b) return;
    const sync = () => {
      b.dataset.paused = String(v.paused);
      b.setAttribute('aria-label', v.paused ? b.dataset.play : b.dataset.pause);
    };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const respect = () => { if (reduce.matches) { v.removeAttribute('autoplay'); v.pause(); } };
    respect();
    reduce.addEventListener('change', respect);
    b.addEventListener('click', () => { v.paused ? v.play() : v.pause(); });
    v.addEventListener('play', sync);
    v.addEventListener('pause', sync);
    sync();
  })();
</script>

<style>
  .hero {
    position: relative;
    margin-top: -76px;
    height: max(680px, 100vh);
    overflow: hidden;
    background: var(--ink-hover);
    color: var(--white);
  }
  .media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(#00000026 0%, #0000001a 13.1179% 60%, #0000004d 100%);
  }
  .toggle {
    all: unset;
    position: absolute;
    right: clamp(20px, 4vw, 72px);
    top: 96px;
    z-index: 1;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    background: rgba(11, 11, 12, .28);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    cursor: pointer;
    opacity: .75;
    transition: opacity .15s ease, background-color .15s ease;
  }
  .toggle:hover { opacity: 1; background: rgba(11, 11, 12, .45); }
  .toggle:focus-visible { opacity: 1; outline: 2px solid var(--white); outline-offset: 2px; }
  .toggle .i-play, .toggle[data-paused='true'] .i-pause { display: none; }
  .toggle[data-paused='true'] .i-play { display: block; }
  .copy {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0 clamp(20px, 4vw, 72px) clamp(32.8px, 4.9vw, 72.2px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px 64px;
    align-items: flex-end;
    justify-content: space-between;
  }
  h1 {
    flex: 0 1 auto;
    margin: 0;
    font-size: var(--display);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -.045em;
    max-width: 11ch;
  }
  .side {
    flex: 0 1 440px;
    margin-left: auto;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  p {
    margin: 0;
    font-size: clamp(14.8px, 1.3vw, 18.9px);
    line-height: 1.35;
    letter-spacing: -.01em;
  }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta {
    padding: 17px 30px;
    border-radius: var(--radius-pill);
    font-size: 16px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color .15s ease;
  }
  .cta-solid { background: var(--white); color: var(--ink); }
  .cta-solid:hover { background: var(--surface-3); color: var(--ink); }
  .cta-ghost { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .7); color: var(--white); }
  .cta-ghost:hover { background: rgba(255, 255, 255, .12); color: var(--white); }
  .cta:focus-visible { outline-color: var(--white); }
</style>
