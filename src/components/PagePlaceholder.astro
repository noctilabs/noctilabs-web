---
import Base from '../layouts/Base.astro';
import HomeHero from './HomeHero.astro';
import { href, type Locale, type PageRef } from '../i18n/routes';
import { PRODUCT_SECTION_IDS, ui } from '../i18n/ui';
import { industry } from '../content/industries';
import { pageMeta } from '../lib/meta';

type SimplePage = Exclude<PageRef, { id: 'industria' } | { id: 'articulo' }>;
interface Props {
  locale: Locale;
  page: SimplePage | Extract<PageRef, { id: 'industria' }>;
}
const { locale, page } = Astro.props;
const t = ui[locale];
const meta = pageMeta(page, locale);
const h1 = page.id === 'industria' ? industry(page.industry, locale).hero.h1 : t.pages[page.id].h1;
---
<Base locale={locale} page={page} title={meta.title} description={meta.description}>
  {page.id === 'home' ? (
    <HomeHero
      title={h1}
      lead={ui[locale].pages.home.lead}
      primary={{ label: t.hero.primary, href: href({ id: 'hablemos' }, locale) }}
      secondary={{ label: t.hero.secondary, href: href({ id: 'producto' }, locale) }}
      pauseLabel={t.hero.pause}
      playLabel={t.hero.play}
    />
  ) : (
    <section class="intro">
      <h1>{h1}</h1>
      <p data-placeholder>{t.placeholder}</p>
    </section>
  )}
  {page.id === 'producto' && PRODUCT_SECTION_IDS.map((id) => (
    <section class="anchor" id={id} tabindex="-1">
      <h2>{t.productSections[id].label}</h2>
      <p data-placeholder>{t.placeholder}</p>
    </section>
  ))}
</Base>

<style>
  .intro, .anchor {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(32.8px, 4.9vw, 72.2px) var(--edge);
  }
  h1 {
    margin: 0;
    font-size: var(--display);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -.045em;
    max-width: 16ch;
  }
  h2 {
    margin: 0;
    font-size: var(--h2);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -.03em;
  }
  p { margin: 16px 0 0; color: var(--muted); }
  .anchor { border-top: 1px solid var(--line); }
</style>
