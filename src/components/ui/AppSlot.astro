---
// Embed de Nocti App v2 (spec 002 §4.8): los mismos props; el interior es la isla React (spec 003 §3.3).
import NoctiApp from '../../islands/noctiapp/NoctiApp.tsx';
import type { Locale } from '../../i18n/routes';

export interface AppSlotProps {
  view: 'inicio' | 'cerebro' | 'inteligencia' | 'agentes' | 'control';
  locale: Locale;
  contactHref: string;
  frame: 'app' | 'none';
  variant?: 'role-demo';
}
interface Props extends AppSlotProps {}
const { view, locale, contactHref, frame, variant } = Astro.props;
---
<div class:list={['slot', `f-${frame}`]}>
  <NoctiApp client:visible view={view} locale={locale} contactHref={contactHref} variant={variant} />
</div>

<style>
  .slot { min-width: 0; }
  .f-app { background: var(--surface-2); border-radius: clamp(19.7px, 2.5vw, 29.5px); padding: clamp(8.2px, 1.3vw, 18px); }
</style>
