---
// Página Insights (spec 002 §4.5, Inv §5): hero, destacado (el más reciente), grilla con el resto y banda.
// Sin filtros (diferidos a la fase 5). Con 0 artículos, estado vacío.
import Base from '../../../layouts/Base.astro';
import HablemosBand from '../../HablemosBand.astro';
import Container from '../../ui/Container.astro';
import Kicker from '../../ui/Kicker.astro';
import ArticleCard from './ArticleCard.astro';
import { href, type Locale } from '../../../i18n/routes';
import { ui } from '../../../i18n/ui';
import { pageMeta } from '../../../lib/meta';
import { formatDate, getArticles } from '../../../lib/insights';
import { categoryLabels } from '../../../content/categories';
import { insights } from '../../../content/pages/insights';

interface Props { locale: Locale }
const { locale } = Astro.props;
const page = { id: 'insights' } as const;
const meta = pageMeta(page, locale);
const t = insights[locale];
const [featured, ...rest] = await getArticles();
---
<Base locale={locale} page={page} title={meta.title} description={meta.description}>
  <div class="page">
    <section class="hero">
      <div class="hero-head">
        <Kicker size={13}>{t.kicker}</Kicker>
        <h1 class="h1-int">{ui[locale].pages.insights.h1}</h1>
      </div>
      <p class="hero-lead">{t.lead}</p>
    </section>

    <Container gap="clamp(26.2px,3.3vw,45.9px)" class="list">
      {featured ? (
        <a class="featured" href={href(featured.ref, locale)}>
          <div class="f-dark">
            <span class="f-kicker">{featured.category ? `${t.featured} · ${categoryLabels[featured.category][locale]}` : t.featured}</span>
            <h2 class="f-title">{featured[locale].title}</h2>
          </div>
          <div class="f-body">
            <p class="f-excerpt">{featured[locale].excerpt}</p>
            <span class="f-foot">
              <span class="f-meta">{formatDate(featured.date, locale)} · {t.minutes(featured[locale].minutes)}</span>
              <span class="f-read">{t.read}</span>
            </span>
          </div>
        </a>
      ) : (
        <p class="empty">{t.empty}</p>
      )}
      {rest.length > 0 && (
        <section aria-labelledby="more-title">
          <h2 id="more-title" class="sr-only">{t.more}</h2>
          <ul class="grid">
            {rest.map((a) => <ArticleCard article={a} locale={locale} />)}
          </ul>
        </section>
      )}
    </Container>
  </div>
  <HablemosBand locale={locale} />
</Base>

<style>
  /* Inv §5: <main> flex column con padding inferior de 24px; la banda va después (Inv §8). */
  .page { display: flex; flex-direction: column; padding-bottom: 24px; }
  .hero {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: clamp(39.4px, 5.7vw, 85.3px) var(--edge) 0;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 64px;
    align-items: flex-end;
  }
  .hero-head { flex: 2 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .hero-lead { flex: 1 1 340px; margin: 0; font-size: 17px; line-height: 1.5; color: var(--muted); padding-bottom: 10px; }
  .page :global(.list) { display: flex; flex-direction: column; gap: 16px; }

  .featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 10px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 32px;
    padding: 10px;
    color: var(--ink);
    text-decoration: none;
  }
  .featured:hover { color: var(--ink); }
  .f-dark {
    position: relative;
    background: var(--dark);
    color: var(--bg);
    border-radius: 24px;
    padding: 28px;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    overflow: hidden;
  }
  .f-dark::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 75% 30%, rgba(61, 123, 255, .28), rgba(61, 123, 255, 0) 50%);
    pointer-events: none;
  }
  .f-kicker {
    position: relative;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #9FBEFF;
  }
  .f-title {
    position: relative;
    margin: 0;
    font-size: clamp(23px, 2.6vw, 37.7px);
    font-weight: 500;
    letter-spacing: -.04em;
    line-height: 1.04;
    text-wrap: pretty;
  }
  .f-body { padding: 22px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }
  .f-excerpt { margin: 0; font-size: 17px; line-height: 1.5; color: var(--muted); }
  .f-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; align-items: center; }
  .f-meta { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  .f-read {
    padding: 11px 18px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color .15s ease;
  }
  .featured:hover .f-read { background: var(--ink-hover); }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 12px;
  }
  .empty {
    margin: 0;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 22px;
    font-size: 17px;
    color: var(--muted);
  }
</style>
