---
// Plantilla de industria (spec 009 §3.D, v6 `Industry Page V2`): hero, «Cómo funciona tu operación», chat, «Dónde
// aparece el valor», CTA con las otras industrias y la banda de cierre (G5).
import Base from '../../../layouts/Base.astro';
import HablemosBand from '../../HablemosBand.astro';
import Button from '../../ui/Button.astro';
import Container from '../../ui/Container.astro';
import DarkBig from '../../ui/DarkBig.astro';
import Kicker from '../../ui/Kicker.astro';
import PageHero from '../producto/PageHero.astro';
import IndustryPhoto from './IndustryPhoto.astro';
import ValueIcon from './ValueIcon.astro';
import IndustryChat from '../../../islands/industria/IndustryChat';
import { industria } from '../../../content/pages/industria';
import { industry as getIndustry, industryPhotos } from '../../../content/industries';
import { href, INDUSTRY_SLUGS, type IndustryId, type Locale } from '../../../i18n/routes';
import { ui } from '../../../i18n/ui';
import { pageMeta } from '../../../lib/meta';

interface Props { locale: Locale; industry: IndustryId }
const { locale, industry } = Astro.props;
const page = { id: 'industria', industry } as const;
const meta = pageMeta(page, locale);
const t = industria[locale];
const ind = getIndustry(industry, locale);
const n = (i: number) => String(i + 1).padStart(2, '0');
const contact = href({ id: 'hablemos' }, locale);
const cta = ui[locale].nav.cta;
const others = (Object.keys(INDUSTRY_SLUGS) as IndustryId[])
  .filter((id) => id !== industry)
  .map((id) => ({ label: getIndustry(id, locale).label, href: href({ id: 'industria', industry: id }, locale) }));
---
<Base locale={locale} page={page} title={meta.title} description={meta.description}>
  <div class="page">
    <PageHero kicker={`${t.kicker} · ${ind.label}`} title={ind.hero.h1} lead={ind.hero.lead} cta={{ label: cta, href: contact }} />
    <IndustryPhoto photo={industryPhotos[industry]} label={ind.label} locale={locale} />

    <Container gap="P" class="stack" aria-labelledby="ops-title">
      <div class="head">
        <Kicker as="p">{t.ops.kicker}</Kicker>
        <h2 id="ops-title" class="h2">{t.ops.title}</h2>
      </div>
      <ol class="ops" role="list" aria-label={t.ops.region} tabindex="0">
        {ind.ops.map((o, i) => (
          <li class="op">
            <span class="num" aria-hidden="true">{n(i)}</span>
            <h3 class="ot">{o.title}</h3>
            <p class="od">{o.text}</p>
          </li>
        ))}
      </ol>
    </Container>

    <Container gap="P" class="stack" aria-labelledby="chat-title">
      <div class="chat-head">
        <div class="head">
          <Kicker as="p">{t.chat.kicker}</Kicker>
          <h2 id="chat-title" class="h2">{t.chat.title}</h2>
        </div>
        <p class="note">{ind.company} · {t.chat.note}</p>
      </div>
      <IndustryChat
        client:visible={{ rootMargin: '400px' }}
        convs={ind.convs}
        company={ind.company}
        copy={t.chat}
        hablemosHref={contact}
        hablemosLabel={`${cta} →`}
      />
    </Container>

    <Container gap="P" class="stack" aria-labelledby="valor-title">
      <div class="head">
        <Kicker as="p">{t.vals.kicker}</Kicker>
        <h2 id="valor-title" class="h2">{t.vals.title}</h2>
      </div>
      <ul class="vals" role="list">
        {ind.vals.map((v, i) => (
          <li class="val">
            <ValueIcon kind={i as 0 | 1 | 2} />
            <h3 class="vt">{v.title}</h3>
            <p class="vd">{v.text}</p>
          </li>
        ))}
      </ul>
    </Container>

    <Container gap="P" aria-labelledby="cta-title">
      <DarkBig class="cta">
        <div class="cta-row">
          <h2 id="cta-title" class="h2 cta-title">{t.cta.title}</h2>
          <Button href={contact} variant="white">{cta}</Button>
        </div>
        <nav class="others" aria-labelledby="otras-title">
          <Kicker as="h3" tone="dark-muted" class="others-label"><span id="otras-title">{t.cta.others}</span></Kicker>
          <ul role="list">
            {others.map((o) => <li><a href={o.href}>{o.label} <span aria-hidden="true">→</span></a></li>)}
          </ul>
        </nav>
      </DarkBig>
    </Container>
  </div>
  <HablemosBand locale={locale} />
</Base>

<script>
  import { initValueIcons } from '../../../scripts/value-icons';
  initValueIcons();
</script>

<style>
  /* v6: el main cierra con 24 px antes de la banda. */
  .page { padding-bottom: 24px; }
  ol, ul { list-style: none; margin: 0; padding: 0; }
  h3, p { margin: 0; }

  .page :global(.stack) { display: flex; flex-direction: column; gap: 24px; }
  .head { display: flex; flex-direction: column; gap: 14px; }
  .num { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }

  /* Tu operación: cinco columnas; bajo 680 px, fila con scroll horizontal hasta el borde (v6 opsBleed). */
  .ops { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .ops:focus-visible { outline-offset: 4px; }
  .op {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 18px 18px 20px;
    min-height: 168px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ot { margin-top: auto; font-size: 19px; font-weight: 500; letter-spacing: -.03em; line-height: 1.1; }
  .od { font-size: 14px; line-height: 1.4; color: var(--muted); }
  @media (max-width: 999.98px) {
    .ops {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--edge);
      margin: 0 calc(var(--edge) * -1);
      padding: 0 var(--edge);
    }
    .ops::-webkit-scrollbar { display: none; }
    .op { flex: 0 0 216px; scroll-snap-align: start; }
  }

  .chat-head { display: flex; flex-wrap: wrap; gap: 14px 48px; align-items: flex-end; justify-content: space-between; }
  .note { font-family: var(--font-mono); font-size: 12px; letter-spacing: .03em; color: var(--muted); }

  .vals { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 12px; }
  .val {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 24px;
    min-height: 240px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .vt { margin-top: auto; font-size: 25px; font-weight: 500; letter-spacing: -.04em; line-height: 1.05; }
  .vd { font-size: 15px; line-height: 1.45; color: var(--muted); max-width: 34ch; }

  .page :global(.cta) { display: flex; flex-direction: column; gap: 28px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 24px 48px; align-items: flex-end; justify-content: space-between; }
  .cta-title { flex: 1 1 420px; max-width: 16ch; }
  .others { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding-top: 24px; border-top: 1px solid #2A2A2C; }
  .others ul { display: contents; }
  .others :global(.others-label) { margin-right: 8px; color: #8A8A90; }
  .others a {
    display: inline-block;
    padding: 9px 16px;
    border-radius: var(--radius-pill);
    background: #1C1C1E;
    color: var(--bg);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color .15s ease;
  }
  .others a:hover { background: #2A2A2C; color: var(--bg); }
  .others a:focus-visible { outline-color: var(--white); }
  @media (max-width: 679.98px) {
    .others a { min-height: 44px; display: inline-flex; align-items: center; }
  }
</style>
