---
// Página Hablemos (spec 002 §4.6, Inv §7): columna de contacto + formulario. Sin banda «Hablemos.».
import Base from '../../../layouts/Base.astro';
import Txt from '../../Brand.astro';
import { INDUSTRY_SLUGS, type IndustryId, type Locale } from '../../../i18n/routes';
import { ui } from '../../../i18n/ui';
import { pageMeta } from '../../../lib/meta';
import { industries } from '../../../content/industries';
import { CONTACT_EMAIL, hablemos } from '../../../content/pages/hablemos';

interface Props { locale: Locale }
const { locale } = Astro.props;
const page = { id: 'hablemos' } as const;
const meta = pageMeta(page, locale);
const t = hablemos[locale];
const f = t.fields;
const mailto = `mailto:${CONTACT_EMAIL}`;

// Tabla de campos de §4.6 (sin Industria ni Mensaje, que van aparte).
const inputs = [
  { name: 'name', type: 'text', autocomplete: 'name', ...f.name },
  { name: 'email', type: 'email', autocomplete: 'email', ...f.email },
  { name: 'organization', type: 'text', autocomplete: 'organization', ...f.organization },
  { name: 'role', type: 'text', autocomplete: 'organization-title', ...f.role },
] as const;
const options = (Object.keys(INDUSTRY_SLUGS) as IndustryId[]).map((id) => ({ value: id, label: industries[id][locale].label }));
---
<Base locale={locale} page={page} title={meta.title} description={meta.description}>
  <div class="page">
    <section class="contact">
      <div class="info">
        <h1 class="h1-int">{ui[locale].pages.hablemos.h1}</h1>
        <p class="lead-hero">{t.lead}</p>
        <ol class="steps">
          {t.steps.map((s, i) => (
            <li><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span><Txt text={s} /></span></li>
          ))}
        </ol>
        <p class="mail">{t.mailPrefix}<a href={mailto}>{CONTACT_EMAIL}</a></p>
      </div>

      <div class="card" data-contact>
        <noscript><p class="noscript">{t.noscript}<a href={mailto}>{CONTACT_EMAIL}</a></p></noscript>
        <form novalidate aria-label={t.formLabel}>
          <fieldset disabled>
            <div class="grid">
              {inputs.map((c) => (
                <div class="field">
                  <label for={`cf-${c.name}`}>{c.label}</label>
                  <input
                    id={`cf-${c.name}`}
                    name={c.name}
                    type={c.type}
                    autocomplete={c.autocomplete}
                    placeholder={c.placeholder}
                    required={'required' in c}
                    spellcheck={c.type === 'email' ? 'false' : undefined}
                    data-required={'required' in c ? c.required : undefined}
                    data-invalid={'invalid' in c ? c.invalid : undefined}
                  />
                  <p class="err" id={`cf-${c.name}-err`} hidden></p>
                </div>
              ))}
            </div>
            <div class="field">
              <label for="cf-industry">{t.industry.label}</label>
              <select id="cf-industry" name="industry">
                <option value="">{t.industry.empty}</option>
                {options.map((o) => <option value={o.value}>{o.label}</option>)}
                <option value="otra">{t.industry.other}</option>
              </select>
              <p class="err" id="cf-industry-err" hidden></p>
            </div>
            <div class="field">
              <label for="cf-message">{f.message.label}</label>
              <textarea id="cf-message" name="message" placeholder={f.message.placeholder} required data-required={f.message.required}></textarea>
              <p class="err" id="cf-message-err" hidden></p>
            </div>
            <button type="submit" class="submit">{t.submit}</button>
          </fieldset>
        </form>
        <div class="live" aria-live="polite">
          <p class="sr-only" data-sending hidden>{t.sending}</p>
          <p class="failed" data-failed hidden>{t.error[0]}<a href={mailto}>{CONTACT_EMAIL}</a>{t.error[1]}</p>
          <div class="sent" data-sent hidden>
            <span class="dot" aria-hidden="true"></span>
            <h2 tabindex="-1">{t.sent}</h2>
            <button type="button" class="again">{t.again}</button>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { initContactForm } from '../../../scripts/contact-form';
  const root = document.querySelector<HTMLElement>('[data-contact]');
  if (root) initContactForm(root);
</script>

<style>
  /* Inv §7: <main> con padding inferior de 24px; es la única página sin banda. */
  .page { padding-bottom: 24px; }
  .contact {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(39.4px, 5.7vw, 85.3px) var(--edge) 0;
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    align-items: flex-start;
  }
  .info { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .steps li {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 16px 20px;
    border-radius: 20px;
    background: var(--white);
    border: 1px solid var(--line);
    font-size: 16px;
  }
  .n { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
  .mail { margin: 0; font-size: 16px; color: var(--muted); overflow-wrap: anywhere; }

  .card {
    flex: 1 1 420px;
    min-width: 0;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 32px;
    padding: clamp(18px, 2.5vw, 29.5px);
  }
  form[hidden] { display: none; }
  fieldset { margin: 0; padding: 0; border: 0; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 14px; }
  .field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .03em;
    text-transform: uppercase;
    color: var(--muted);
  }
  input, select, textarea {
    font: inherit;
    font-size: 16px;
    width: 100%;
    min-width: 0;
    padding: 13px 16px;
    border-radius: 14px;
    /* §7, 6b: borde #767676 (3:1 de identificación de controles) en lugar de #E2E2DE. */
    border: 1px solid #767676;
    background-color: var(--bg);
    color: var(--ink);
    transition: border-color .15s ease, background-color .15s ease;
  }
  input::placeholder, textarea::placeholder { color: var(--muted); opacity: 1; }
  input:focus, select:focus, textarea:focus { border-color: var(--blue); background-color: var(--white); outline: 2px solid var(--blue-link); outline-offset: 2px; }
  textarea { min-height: 130px; resize: vertical; }
  [aria-invalid='true'] { border-color: #B42318; }
  .err { margin: 0; font-size: 14px; line-height: 1.4; color: #B42318; }
  .submit {
    font: inherit;
    cursor: pointer;
    border: 0;
    text-align: center;
    padding: 16px 26px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    font-size: 15px;
    font-weight: 500;
    transition: background-color .15s ease;
  }
  .submit:hover { background: var(--ink-hover); }
  .submit:disabled { cursor: progress; }
  .noscript, .failed { margin: 0; font-size: 16px; color: var(--muted); overflow-wrap: anywhere; }
  .noscript { margin-bottom: 16px; }
  .failed { margin-top: 16px; }
  .sent {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 320px;
    justify-content: center;
    align-items: flex-start;
  }
  .sent[hidden] { display: none; }
  .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--blue); }
  .sent h2 { margin: 0; font-size: 30px; font-weight: 500; letter-spacing: -.04em; line-height: 1.08; }
  .again {
    font: inherit;
    cursor: pointer;
    border: 0;
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
  }
  .again:hover { background: var(--surface-2); }
  @media (prefers-reduced-motion: reduce) {
    input, select, textarea, .submit { transition: none; }
  }
</style>
