---
// «El valor de una capa compartida», versión Editorial de v4 (spec 007 §3.4, V4 L546–562).
import ValueRows from '../../../islands/producto/ValueRows.tsx';
import type { ProductoCopy } from '../../../content/pages/producto';

interface Props { t: ProductoCopy['valor'] }
const { t } = Astro.props;
---
<section class="valor" id="valor" aria-labelledby="valor-title">
  <div class="head">
    <p class="kick">{t.kicker}</p>
    <h2 id="valor-title">{t.title}</h2>
    <p class="lead">{t.lead}</p>
  </div>
  <ValueRows client:visible rows={t.rows} />
  <p class="close">{t.close}</p>
</section>

<style>
  .valor { max-width: 1200px; width: 100%; margin: clamp(64px, 8vw, 128px) auto 0; padding: 0 var(--edge); }
  .head { display: flex; flex-direction: column; gap: 18px; padding-bottom: clamp(40px, 5vw, 72px); }
  .kick { margin: 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  h2 { margin: 0; font-size: var(--display); font-weight: 500; line-height: .98; letter-spacing: -.05em; max-width: 14ch; }
  .lead { margin: 0; font-size: clamp(17px, 1.5vw, 20px); color: var(--muted); max-width: 46ch; }
  .close { margin: clamp(48px, 6vw, 96px) 0 0; font-size: clamp(32px, 4.4vw, 68px); font-weight: 500; letter-spacing: -.05em; line-height: 1.02; max-width: 20ch; }

  .valor :global(.vr) { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .valor :global(.vr-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px 40px;
    align-items: center;
    padding: clamp(22px, 3vw, 40px) 16px;
    margin: 0 -16px;
    border-bottom: 1px solid #D9D9D4;
    transition: background-color .3s;
  }
  .valor :global(.vr-row:hover) { background: #EBEBE7; }
  .valor :global(.vr-ic) { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .valor :global(.vr-n) { font-family: var(--font-mono); font-size: 12px; letter-spacing: .04em; color: var(--muted); }
  .valor :global(.vr-t) { margin: 0; font-size: clamp(28px, 3.8vw, 58px); font-weight: 500; line-height: 1; letter-spacing: -.05em; }
  .valor :global(.vr-d) { margin: 0; font-size: 16px; line-height: 1.5; color: var(--body-2); max-width: 34ch; }
  @media (min-width: 900px) {
    .valor :global(.vr-row) { grid-template-columns: 96px minmax(0, 1fr) minmax(0, 320px); }
  }
</style>
