---
// «El valor de una capa compartida», variante «C · Editorial» de la v4 (spec 007 §3.D; diseño L533–549 y L1460–1461):
// seis filas con ícono, título grande y bajada. Los íconos se animan una vez al entrar en pantalla y otra vez con el hover
// de su fila (≈ 1 s, nada con reduced motion).
import Container from '../../ui/Container.astro';
import Kicker from '../../ui/Kicker.astro';
import NIcon from './NIcon.astro';
import { valor } from '../../../content/pages/producto-valor';
import type { Locale } from '../../../i18n/routes';

interface Props { locale: Locale }
const t = valor[Astro.props.locale];
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<Container gap="clamp(64px,8vw,128px)" id="valor" tabindex="-1" aria-labelledby="valor-title">
  <div class="head">
    <Kicker as="p">{t.kicker}</Kicker>
    <h2 id="valor-title" class="title">{t.title}</h2>
    <p class="lead">{t.lead}</p>
  </div>
  <div class="rows">
    {t.rows.map((r, i) => (
      <div class="row" data-valor-row>
        <div class="mark">
          <NIcon k={r.icon} size={48} auto prime />
          <span class="n" aria-hidden="true">{num(i)}</span>
        </div>
        <h3>{r.title}</h3>
        <p>{r.text}</p>
      </div>
    ))}
  </div>
</Container>

<script>
  import { initIcons, playIcon } from '../../../scripts/nicon';
  const root = document.querySelector<HTMLElement>('#valor');
  if (root) {
    initIcons(root);
    for (const row of root.querySelectorAll<HTMLElement>('[data-valor-row]')) {
      const svg = row.querySelector<SVGSVGElement>('svg[data-nicon]');
      if (svg) row.addEventListener('mouseenter', () => playIcon(svg));
    }
  }
</script>

<style>
  .head { display: flex; flex-direction: column; gap: 18px; padding-bottom: clamp(40px, 5vw, 72px); }
  .title { margin: 0; font-size: var(--display); font-weight: 500; line-height: .98; letter-spacing: -.05em; max-width: 14ch; }
  .lead { margin: 0; font-size: clamp(17px, 1.5vw, 20px); color: var(--muted); max-width: 46ch; }

  .rows { border-top: 2px solid var(--ink); }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px 40px;
    align-items: center;
    padding: clamp(22px, 3vw, 40px) 16px;
    margin: 0 -16px;
    border-bottom: 1px solid #D9D9D4;
    transition: background .3s;
  }
  @media (min-width: 900px) { .row { grid-template-columns: 96px minmax(0, 1fr) minmax(0, 320px); } }
  @media (hover: hover) { .row:hover { background: #EBEBE7; } }
  .mark { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; color: var(--ink); --ac: var(--blue); }
  .n { font-family: var(--font-mono); font-size: 12px; letter-spacing: .04em; color: var(--muted); }
  h3 { margin: 0; font-size: clamp(28px, 3.8vw, 58px); font-weight: 500; line-height: 1; letter-spacing: -.05em; }
  .row p { margin: 0; font-size: 16px; line-height: 1.5; color: var(--body-2); max-width: 34ch; }

  @media (prefers-reduced-motion: reduce) { .row { transition: none; } }
</style>
