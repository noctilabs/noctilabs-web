---
// Página Producto (spec 002 §4.2; orden y títulos de la v4, spec 007 §3.C): título, la demo general (solo escritorio, como
// en la v4), las preguntas por rol, Overview, Inteligencia, Agentes, Valor, Control y el CTA.
import Base from '../../../layouts/Base.astro';
import HablemosBand from '../../HablemosBand.astro';
import AppSlot from '../../ui/AppSlot.astro';
import PageHero from './PageHero.astro';
import Overview from './Overview.astro';
import ModuleSection from './ModuleSection.astro';
import Valor from './Valor.astro';
import Control from './Control.astro';
import RolesDemo from '../../../islands/producto/RolesDemo.tsx';
import Inteligencia from '../../../islands/producto/Inteligencia.tsx';
import AgentFlow from '../../../islands/producto/AgentFlow.tsx';
import { producto } from '../../../content/pages/producto';
import { href, type Locale } from '../../../i18n/routes';
import { ui } from '../../../i18n/ui';
import { pageMeta } from '../../../lib/meta';

interface Props { locale: Locale }
const { locale } = Astro.props;
const page = { id: 'producto' } as const;
const meta = pageMeta(page, locale);
const t = producto[locale];
const contactHref = href({ id: 'hablemos' }, locale);
const [roles, bi, agentes] = t.sections;
---
<Base locale={locale} page={page} title={meta.title} description={meta.description}>
  <div class="page">
    <PageHero
      kicker={t.hero.kicker}
      title={ui[locale].pages.producto.h1}
      lead={t.hero.lead}
      cta={{ label: ui[locale].nav.cta, href: contactHref }}
    />
    <div class="demo">
      <AppSlot view="inicio" locale={locale} contactHref={contactHref} frame="app" />
      <p class="caption">{t.demoCaption}</p>
    </div>
    <ModuleSection s={roles} note="dot">
      <RolesDemo client:visible locale={locale} />
    </ModuleSection>
    <Overview t={t.overview} />
    <ModuleSection s={bi} chips>
      <Inteligencia client:visible locale={locale} />
    </ModuleSection>
    <ModuleSection s={agentes} contactHref={contactHref}>
      <AgentFlow client:visible locale={locale} />
    </ModuleSection>
    <Valor locale={locale} />
    <Control t={t.control} locale={locale} contactHref={contactHref} />
  </div>
  <HablemosBand locale={locale} />
</Base>

<style>
  /* Inv §2: el main del diseño cierra con 24 px antes de la banda. */
  .page { padding-bottom: 24px; }
  .demo {
    max-width: 1320px;
    width: 100%;
    margin: 0 auto;
    padding: clamp(26.2px, 3.3vw, 45.9px) var(--edge) 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .caption { margin: 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: .03em; color: var(--muted); padding-left: 8px; }
  /* v4: la demo general solo se muestra en escritorio (por debajo de 680 px la página arranca en las preguntas por rol). */
  @media (max-width: 679.98px) { .demo { display: none; } }
</style>
