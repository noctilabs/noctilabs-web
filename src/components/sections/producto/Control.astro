---
// Control y gobernanza (Inv §2.5): capas, barra y la demo de aprobación.
// Capas en 1 columna por debajo de 600 px (spec 002 §4.2.5); sin caption mientras sea placeholder (§4.2.6).
import Container from '../../ui/Container.astro';
import CardBig from '../../ui/CardBig.astro';
import HeadRow from '../../ui/HeadRow.astro';
import Kicker from '../../ui/Kicker.astro';
import AppSlot from '../../ui/AppSlot.astro';
import type { ProductoCopy } from '../../../content/pages/producto';
import type { Locale } from '../../../i18n/routes';

interface Props { t: ProductoCopy['control']; locale: Locale; contactHref: string }
const { t, locale, contactHref } = Astro.props;
---
<Container gap="P" id="control" tabindex="-1" aria-labelledby="control-title">
  <CardBig variant="p" class="ctl">
    <HeadRow>
      <Kicker as="p">{t.kicker}</Kicker>
      <h2 id="control-title" class="h2">{t.title}</h2>
      <Fragment slot="lead">{t.lead}</Fragment>
    </HeadRow>
    <div class="layers">
      <ul class="grid">{t.layers.map((l) => <li>{l}</li>)}</ul>
      <div class="bar">
        <span class="bt">{t.bar.title}</span>
        <span class="bl">{t.bar.list}</span>
      </div>
    </div>
    <AppSlot view="control" locale={locale} contactHref={contactHref} frame="control" />
  </CardBig>
</Container>

<style>
  .ctl { display: flex; flex-direction: column; gap: 28px; }
  .layers { display: flex; flex-direction: column; gap: 8px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
  @media (min-width: 600px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .grid li {
    background: var(--bg);
    border-radius: 20px;
    padding: 22px 18px;
    font-size: clamp(14.8px, 1.6vw, 21.3px);
    font-weight: 500;
    letter-spacing: -.03em;
  }
  .bar {
    background: var(--dark);
    color: var(--bg);
    border-radius: 20px;
    padding: 20px 22px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    align-items: center;
  }
  .bt { font-size: clamp(16.4px, 1.8vw, 23px); font-weight: 500; letter-spacing: -.03em; }
  .bl { font-family: var(--font-mono); font-size: 12px; letter-spacing: .03em; text-transform: uppercase; color: #A7A7AC; }
</style>
