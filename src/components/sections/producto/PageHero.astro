---
// Hero de páginas internas con CTA (Inv §2.1 y §3.1): kicker + H1-INT a la izquierda, lead + botón a la derecha.
import Kicker from '../../ui/Kicker.astro';
import Button from '../../ui/Button.astro';
import Brand from './Brand.astro';

interface Props { kicker: string; title: string; lead: string; cta: { label: string; href: string } }
const { kicker, title, lead, cta } = Astro.props;
---
<section class="hero">
  <div class="main">
    <Kicker size={13} as="p"><Brand text={kicker} /></Kicker>
    <h1 class="h1-int"><Brand text={title} /></h1>
  </div>
  <div class="side">
    <p class="lead-hero"><Brand text={lead} /></p>
    <div class="actions"><Button href={cta.href}>{cta.label}</Button></div>
  </div>
</section>

<style>
  .hero {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: clamp(39.4px, 5.7vw, 85.3px) var(--edge) 0;
    display: flex;
    flex-wrap: wrap;
    gap: 32px 64px;
    align-items: flex-end;
  }
  .main { flex: 2 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .side { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 24px; padding-bottom: 10px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
</style>
