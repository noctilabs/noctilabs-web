---
// Antes y después, sólo Opción 1 (spec 002 §4.1.2, enmienda 2026-10-04; Inv §1.2, §9.10 y §9.12).
// El HTML sale en estado «con» y sin control (sin JS). Los textos de cada estado se apilan en la misma celda
// de grid y el inactivo queda con visibility:hidden: fuera del árbol accesible y sin saltos de alto al alternar.
// Como en el diseño, la Opción 1 no lleva el cierre («Tus sistemas siguen siendo tus sistemas…»).
import Container from '../../ui/Container.astro';
import CardBig from '../../ui/CardBig.astro';
import Kicker from '../../ui/Kicker.astro';
import Txt from '../../Brand.astro';
import { DIAGRAMS, type DiagramNode, type Place } from './diagrams';
import { home, type BaState } from '../../../content/pages/home';
import type { Locale } from '../../../i18n/routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = home[locale].before;
const STATES: BaState[] = ['sin', 'con'];

// Cada nodo lleva su lugar en los dos estados como variables (0 = «sin», 1 = «con»); el CSS elige según data-state.
const placeVars = ([x, y, r = 0, s = 1, o = 1]: Place, k: 0 | 1) =>
  [`--x${k}:${+x.toFixed(2)}%`, `--y${k}:${+y.toFixed(2)}%`, r && `--r${k}:${r}deg`, s !== 1 && `--s${k}:${s}`, o !== 1 && `--o${k}:${o}`];
const nodeStyle = (n: DiagramNode) =>
  [...placeVars(n.at.sin, 0), ...placeVars(n.at.con, 1), n.wd?.sin && `--w0:${n.wd.sin}`, n.wd?.con && `--w1:${n.wd.con}`].filter(Boolean).join(';');
---
<Container gap="L">
  <CardBig>
    <div class="ba" data-ba data-state="con">
      <Kicker><Txt text={t.kicker} /></Kicker>
      <div class="watch">
        <h2 class="h2 title m">
          {STATES.map((s) => <span class={`s-${s}`}>{t.title[s]}</span>)}
        </h2>
        <div class="seg" role="group" aria-label={t.control} data-ba-control hidden>
          {STATES.map((s) => (
            <button type="button" aria-pressed={s === 'con' ? 'true' : 'false'} aria-describedby="ba-hint" data-ba-set={s}>
              {t.word[s]} <span translate="no">Nocti</span>
            </button>
          ))}
        </div>
        <p id="ba-hint" class="sr-only">{t.hint}</p>
      </div>
      <div class="grid" data-ba-trigger>
        {DIAGRAMS.map((g, i) => {
          const d = t.diagrams[i]!;
          return (
            <figure class="item">
              <div class="canvas" aria-hidden="true">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                  {g.lines.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
                </svg>
                {g.nodes.map((n) => (
                  <div class:list={['node', `k-${n.kind}`, n.sinKind && `sin-${n.sinKind}`]} style={nodeStyle(n)}>
                    {n.labelSin
                      ? <><span class="l-sin"><Txt text={t.labels[n.labelSin]} /></span><span class="l-con"><Txt text={t.labels[n.label]} /></span></>
                      : <span><Txt text={t.labels[n.label]} /></span>}
                  </div>
                ))}
              </div>
              <p class="sr-only">
                {STATES.map((s) => <span class={`d-${s}`}><Txt text={d.desc[s]} /></span>)}
              </p>
              <figcaption class="cap">
                <span class="cap-k m">
                  {STATES.map((s) => <span class={`s-${s}`}>{t.word[s]} <span translate="no">Nocti</span></span>)}
                </span>
                <span class="cap-t m">{STATES.map((s) => <span class={`s-${s}`}>{d.title[s]}</span>)}</span>
                <span class="cap-x m">{STATES.map((s) => <span class={`s-${s}`}>{d.text[s]}</span>)}</span>
              </figcaption>
            </figure>
          );
        })}
      </div>
      <p class="sr-only" aria-live="polite" data-ba-live data-live-sin={t.live.sin} data-live-con={t.live.con}></p>
    </div>
  </CardBig>
</Container>

<script>
  import { initBeforeAfter } from '../../../scripts/before-after';
  const root = document.querySelector<HTMLElement>('[data-ba]');
  if (root) initBeforeAfter(root);
</script>

<style>
  .ba { display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .watch { display: flex; flex-direction: column; align-items: center; gap: 28px; max-width: 100%; }
  /* §7.6: sin nowrap; el H2 puede ocupar varias líneas en mobile. */
  .title { text-align: center; }

  /* Textos por estado apilados: el alto es el del más largo y el inactivo no se lee. */
  .m { display: grid; }
  .m > * { grid-area: 1 / 1; }
  [data-state='sin'] .s-con, [data-state='con'] .s-sin { visibility: hidden; }
  [data-state='sin'] .d-con, [data-state='con'] .d-sin { display: none; }

  .seg { display: flex; gap: 4px; padding: 4px; border-radius: var(--radius-pill); background: #ECECE8; }
  .seg[hidden] { display: none; }
  .seg button {
    appearance: none;
    border: 0;
    margin: 0;
    cursor: pointer;
    padding: 10px 20px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.55;
    background: transparent;
    color: var(--muted);
  }
  .seg button:hover { color: var(--ink); }
  .seg button[aria-pressed='true'] { background: var(--white); color: var(--ink); box-shadow: 0 1px 2px rgba(11, 11, 12, .08); }

  .grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
    margin-top: 8px;
  }
  .item { margin: 0; display: flex; flex-direction: column; gap: 18px; min-width: 0; }

  /* Lienzo: los nodos escalan con el ancho (§4.1.2, «Nodos a 320 px»). --u = tamaño de los nodos de 13 px. */
  .canvas {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 24px;
    overflow: hidden;
    background: var(--bg);
    container-type: inline-size;
    --u: clamp(9px, 3.4cqw, 13px);
  }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* oldLines: sin círculos, todas con el mismo delay. */
  line { stroke: var(--blue-light); stroke-width: 1.5; vector-effect: non-scaling-stroke; transition: opacity .5s .55s; }
  [data-state='sin'] line { opacity: 0; transition-delay: 0s; }

  /* oldNode: el nodo se desplaza, rota y escala entre los lugares de cada estado (--x0…--o0 «sin», --x1…--o1 «con»). */
  .node {
    position: absolute;
    left: var(--x1);
    top: var(--y1);
    width: var(--w1, auto);
    opacity: var(--o1, 1);
    transform: translate(-50%, -50%) rotate(var(--r1, 0deg)) scale(var(--s1, 1));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--u) * 7 / 13) var(--u);
    border: 1px solid #D9D9D4;
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--ink);
    font-size: var(--u);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    text-align: center;
    transition: left .9s cubic-bezier(.7, 0, .2, 1), top .9s cubic-bezier(.7, 0, .2, 1), transform .9s cubic-bezier(.7, 0, .2, 1),
      opacity .6s, background-color .6s, color .6s;
  }
  [data-state='sin'] .node {
    left: var(--x0);
    top: var(--y0);
    width: var(--w0, auto);
    opacity: var(--o0, 1);
    transform: translate(-50%, -50%) rotate(var(--r0, 0deg)) scale(var(--s0, 1));
  }
  .k-agent { background: #EEF3FF; color: var(--blue-link); border-color: #A9C4FF; }
  .k-dark, [data-state='sin'] .sin-dark { background: var(--ink); color: var(--white); border-color: var(--ink); }
  .k-core { background: var(--blue); color: var(--white); border-color: var(--blue); }
  /* OLD_FADED con el contraste de chipOff (§4.1.2): texto #6B6B68 (4,85:1) y borde punteado #9A9A96. */
  [data-state='sin'] .sin-faded { background: transparent; color: #6B6B68; border: 1px dashed #9A9A96; }
  [data-state='sin'] .l-con, [data-state='con'] .l-sin { display: none; }

  .cap { display: flex; flex-direction: column; gap: 6px; padding: 0 6px 4px; min-height: 120px; }
  .cap-k {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--blue-link);
  }
  [data-state='sin'] .cap-k { color: var(--muted); }
  .cap-t { font-size: 26px; font-weight: 500; letter-spacing: -.04em; line-height: 1.05; }
  .cap-x { font-size: 16px; color: var(--muted); }

  @media (prefers-reduced-motion: reduce) {
    line, .node, [data-state='sin'] line { transition: none; }
  }
</style>
