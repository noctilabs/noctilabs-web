---
// Antes y después, sólo Opción 2 (spec 002 §4.1.2, Inv §1.2 y §9.10–9.11).
// El HTML sale en estado «con» y sin control (sin JS). Los textos de cada estado se apilan en la misma celda
// de grid y el inactivo queda con visibility:hidden: fuera del árbol accesible y sin saltos de alto al alternar.
import Container from '../../ui/Container.astro';
import CardBig from '../../ui/CardBig.astro';
import Kicker from '../../ui/Kicker.astro';
import Txt from '../../Brand.astro';
import { DIAGRAMS, type DiagramNode } from './diagrams';
import { home, type BaState } from '../../../content/pages/home';
import type { Locale } from '../../../i18n/routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = home[locale].before;
const STATES: BaState[] = ['sin', 'con'];

const nodeStyle = (n: DiagramNode) =>
  [`left:${n.x}%`, `top:${n.y}%`, n.wd && `width:${n.wd}`, n.ht && `height:${n.ht}`, n.off && `--s:${n.off}`].filter(Boolean).join(';');
---
<Container gap="L">
  <CardBig>
    <div class="ba" data-ba data-state="con">
      <Kicker>{t.kicker}</Kicker>
      <div class="watch" data-ba-watch>
        <h2 class="h2 title m">
          {STATES.map((s) => <span class={`s-${s}`}>{t.title[s]}</span>)}
        </h2>
        <div class="seg" role="group" aria-label={t.kicker} data-ba-control hidden>
          {STATES.map((s) => (
            <button type="button" aria-pressed={s === 'con' ? 'true' : 'false'} aria-describedby="ba-hint" data-ba-set={s}>
              {t.word[s]} <span translate="no">Nocti</span>
            </button>
          ))}
        </div>
        <p id="ba-hint" class="sr-only">{t.hint}</p>
      </div>
      <div class="grid">
        {DIAGRAMS.map((g, i) => {
          const d = t.diagrams[i]!;
          return (
            <figure class="item">
              <div class="canvas" aria-hidden="true">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                  {g.lines.map(([x1, y1, x2, y2], j) => (
                    <g style={`--i:${j}`}>
                      <line x1={x1} y1={y1} x2={x2} y2={y2} />
                      <circle cx={x1} cy={y1} r=".9" />
                      <circle cx={x2} cy={y2} r=".9" />
                    </g>
                  ))}
                </svg>
                {g.nodes.map((n) => (
                  <div class:list={['node', `k-${n.kind}`, { tog: n.off }]} style={nodeStyle(n)}>
                    <span>{n.label ? <Txt text={t.labels[n.label]} /> : '✓'}</span>
                  </div>
                ))}
              </div>
              <p class="sr-only">
                {STATES.map((s) => <span class={`d-${s}`}><Txt text={d.desc[s]} /></span>)}
              </p>
              <figcaption class="cap">
                <span class="cap-k m">
                  {STATES.map((s) => <span class={`s-${s}`}>{t.word[s]} <span translate="no">Nocti</span></span>)}
                </span>
                <span class="cap-t m">{STATES.map((s) => <span class={`s-${s}`}>{d.title[s]}</span>)}</span>
                <span class="cap-x m">{STATES.map((s) => <span class={`s-${s}`}>{d.text[s]}</span>)}</span>
              </figcaption>
            </figure>
          );
        })}
      </div>
      <div class="close">
        <p class="c1">{t.close[0]}</p>
        <p class="c2"><Txt text={t.close[1]} /></p>
      </div>
      <p class="sr-only" aria-live="polite" data-ba-live data-live-sin={t.live.sin} data-live-con={t.live.con}></p>
    </div>
  </CardBig>
</Container>

<script>
  import { initBeforeAfter } from '../../../scripts/before-after';
  const root = document.querySelector<HTMLElement>('[data-ba]');
  if (root) initBeforeAfter(root);
</script>

<style>
  .ba { display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .watch { display: flex; flex-direction: column; align-items: center; gap: 28px; max-width: 100%; }
  /* §7.6: sin nowrap; el H2 puede ocupar varias líneas en mobile. */
  .title { text-align: center; }

  /* Textos por estado apilados: el alto es el del más largo y el inactivo no se lee. */
  .m { display: grid; }
  .m > * { grid-area: 1 / 1; }
  [data-state='sin'] .s-con, [data-state='con'] .s-sin { visibility: hidden; }
  [data-state='sin'] .d-con, [data-state='con'] .d-sin { display: none; }

  .seg { display: flex; gap: 4px; padding: 4px; border-radius: var(--radius-pill); background: #ECECE8; }
  .seg[hidden] { display: none; }
  .seg button {
    appearance: none;
    border: 0;
    margin: 0;
    cursor: pointer;
    padding: 10px 20px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.55;
    background: transparent;
    color: var(--muted);
  }
  .seg button:hover { color: var(--ink); }
  .seg button[aria-pressed='true'] { background: var(--white); color: var(--ink); box-shadow: 0 1px 2px rgba(11, 11, 12, .08); }

  .grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
    margin-top: 8px;
  }
  .item { margin: 0; display: flex; flex-direction: column; gap: 18px; min-width: 0; }

  /* Lienzo: los nodos escalan con el ancho (§4.1.2, «Nodos a 320 px»). --u = tamaño de los nodos de 13 px. */
  .canvas {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 24px;
    overflow: hidden;
    background: var(--bg);
    container-type: inline-size;
    --u: clamp(9px, 3.4cqw, 13px);
  }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  line { stroke: var(--blue-light); stroke-width: 1.4; vector-effect: non-scaling-stroke; }
  circle { fill: var(--blue); }
  g { transition: opacity .5s calc(.35s + var(--i) * .05s); }
  [data-state='sin'] g { opacity: 0; transition-delay: 0s; }

  .node {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--u) * 7 / 13) var(--u);
    border: 1px solid #D9D9D4;
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--ink);
    font-size: var(--u);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    text-align: center;
    transition: transform .9s cubic-bezier(.7, 0, .2, 1), opacity .6s, background-color .6s, color .6s;
  }
  .k-srcSm, .k-chip { padding: calc(var(--u) * 5 / 13) calc(var(--u) * 9 / 13); font-size: calc(var(--u) * 12 / 13); }
  .k-chip { padding-inline: calc(var(--u) * 10 / 13); background: var(--bg); border-color: var(--line); }
  /* chipOff (§4.1.2): texto #6B6B68 (4,85:1) y borde punteado #9A9A96. */
  [data-state='sin'] .k-chip { background: transparent; color: var(--muted); border: 1px dashed #9A9A96; }
  .k-dark { padding-inline: calc(var(--u) * 18 / 13); background: var(--ink); color: var(--white); border-color: var(--ink); }
  .k-agent, .k-layer { background: #EEF3FF; color: var(--blue-link); border-color: #A9C4FF; }
  .k-layer, .k-block, .k-tag { font-family: var(--font-mono); letter-spacing: .04em; }
  .k-layer, .k-block, .k-badge { font-size: calc(var(--u) * 11 / 13); }
  .k-layer { border-radius: 14px; padding: 0 calc(var(--u) * 12 / 13); }
  .k-block { align-items: flex-start; border-radius: 18px; border-color: #A9C4FF; padding: calc(var(--u) * 9 / 13) calc(var(--u) * 12 / 13); }
  .k-tag {
    padding: calc(var(--u) * 3 / 13) calc(var(--u) * 8 / 13);
    background: var(--blue);
    color: var(--white);
    border-color: var(--blue);
    font-size: calc(var(--u) * 10 / 13);
    letter-spacing: .03em;
  }
  .k-badge {
    width: calc(var(--u) * 20 / 13);
    height: calc(var(--u) * 20 / 13);
    padding: 0;
    color: var(--blue-link);
    border-color: #A9C4FF;
  }
  [data-state='sin'] .tog { opacity: 0; transform: translate(-50%, -50%) scale(var(--s)); }

  .cap { display: flex; flex-direction: column; gap: 6px; padding: 0 6px 4px; min-height: 120px; }
  .cap-k {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--blue-link);
  }
  [data-state='sin'] .cap-k { color: var(--muted); }
  .cap-t { font-size: 26px; font-weight: 500; letter-spacing: -.04em; line-height: 1.05; }
  .cap-x { font-size: 16px; color: var(--muted); }

  .close {
    width: 100%;
    border-top: 1px solid var(--line);
    margin-top: 8px;
    padding-top: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: opacity .6s, transform .6s, visibility 0s;
  }
  /* Con «sin», el cierre sale del árbol accesible cuando termina de desvanecerse. */
  [data-state='sin'] .close { opacity: 0; transform: translateY(8px); visibility: hidden; transition: opacity .6s, transform .6s, visibility 0s .6s; }
  .c1, .c2 { margin: 0; font-weight: 500; }
  .c1 { font-size: clamp(26px, 3.2vw, 44px); letter-spacing: -.045em; line-height: 1.05; }
  .c2 { font-size: clamp(20px, 2.2vw, 30px); letter-spacing: -.035em; line-height: 1.2; color: var(--muted); max-width: 36ch; }

  @media (prefers-reduced-motion: reduce) {
    g, .node, .close, [data-state='sin'] g, [data-state='sin'] .close { transition: none; }
  }
</style>
