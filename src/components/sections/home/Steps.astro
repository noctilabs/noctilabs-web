---
// Cuatro pasos (spec 002 §4.1.5, Inv §1.5): la 04 oscura por defecto; con hover sobre otra, la 04 vuelve a clara.
import Container from '../../ui/Container.astro';
import CardBig from '../../ui/CardBig.astro';
import HeadRow from '../../ui/HeadRow.astro';
import Txt from './Txt.astro';
import type { Locale } from '../../../i18n/routes';
import { home } from '../../../content/pages/home';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = home[locale].steps;
---
<Container gap="L">
  <CardBig>
    <div class="wrap">
      <HeadRow>
        <h2 class="h2"><Txt text={t.h2} /></h2>
        <Fragment slot="lead"><Txt text={t.lead} /></Fragment>
      </HeadRow>
      <ol class="steps">
        {t.items.map((s) => (
          <li class="step">
            <span class="n">{s.n} · <Txt text={s.who} /></span>
            <h3>{s.t}</h3>
            <p class="d"><Txt text={s.d} /></p>
            <p class="ex"><span class="bullet" aria-hidden="true"></span>{s.ex}</p>
          </li>
        ))}
      </ol>
    </div>
  </CardBig>
</Container>

<style>
  .wrap { display: flex; flex-direction: column; gap: 36px; }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 12px;
  }
  .step {
    border-radius: 24px;
    padding: 24px;
    min-height: 250px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--bg);
    color: var(--ink);
  }
  .n { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
  h3 { margin: auto 0 0; font-size: 26px; font-weight: 500; letter-spacing: -.04em; line-height: 1.05; }
  .d { margin: 0; font-size: 15px; opacity: .75; }
  .ex {
    margin: 0;
    display: flex;
    gap: 8px;
    align-items: baseline;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.45;
    color: var(--body-2);
  }
  .bullet { width: 6px; height: 6px; border-radius: 50%; background: var(--blue-light); flex: none; transform: translateY(-1px); }

  /* Oscura: la 04 por defecto. */
  .step:last-child { background: var(--dark); color: var(--bg); }
  .step:last-child .n { color: #A7A7AC; }
  .step:last-child .ex { color: #D9D9DC; border-top-color: #2A2A2E; }

  @media (hover: hover) {
    .step { transition: background-color .3s, color .3s, transform .3s cubic-bezier(.4, 0, .2, 1); }
    .n, .ex { transition: color .3s, border-color .3s; }
    .step:hover { background: var(--dark); color: var(--bg); transform: translateY(-4px); }
    .step:hover .n { color: #9FBEFF; }
    .step:hover .ex { color: #D9D9DC; border-top-color: #2A2A2E; }
    .steps:has(.step:hover) .step:last-child:not(:hover) { background: var(--bg); color: var(--ink); }
    .steps:has(.step:hover) .step:last-child:not(:hover) .n { color: var(--muted); }
    .steps:has(.step:hover) .step:last-child:not(:hover) .ex { color: var(--body-2); border-top-color: var(--line); }
  }
  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    .step, .n, .ex { transition: none; }
    .step:hover { transform: none; }
  }
</style>
