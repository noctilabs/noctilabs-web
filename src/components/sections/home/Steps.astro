---
// Cuatro pasos (spec 002 §4.1.5, Inv §1.5): la 04 oscura por defecto; con hover sobre otra, la 04 vuelve a clara.
// Spec 009 §3.C: número, título, frase y detalle del v6, todo siempre visible (sin el pliegue de F6 ni el «· quién»).
import Container from '../../ui/Container.astro';
import CardBig from '../../ui/CardBig.astro';
import HeadRow from '../../ui/HeadRow.astro';
import Txt from '../../Brand.astro';
import type { Locale } from '../../../i18n/routes';
import { home } from '../../../content/pages/home';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = home[locale].steps;
---
<Container gap="L">
  <CardBig>
    <div class="wrap">
      <HeadRow>
        <h2 class="h2"><Txt text={t.h2} /></h2>
        <Fragment slot="lead"><Txt text={t.lead} /></Fragment>
      </HeadRow>
      <ol class="steps">
        {t.items.map((s) => (
          <li class="step">
            <span class="n">{s.n}</span>
            <h3>{s.t}</h3>
            <p class="d"><Txt text={s.d} /></p>
            <p class="ex">{s.ex}</p>
          </li>
        ))}
      </ol>
    </div>
  </CardBig>
</Container>

<style>
  .wrap { display: flex; flex-direction: column; gap: 36px; }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 12px;
  }
  .step {
    border-radius: 24px;
    padding: 24px;
    min-height: 250px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--bg);
    color: var(--ink);
  }
  .n { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
  h3 { margin: auto 0 0; font-size: clamp(20px, 1.6vw, 23px); font-weight: 500; letter-spacing: -.04em; line-height: 1.05; }
  /* v6: la frase en 16 px peso 500 y el detalle en 14,5 px al 72 %. */
  .d { margin: 0; font-size: 16px; font-weight: 500; line-height: 1.3; letter-spacing: -.01em; }
  .ex { margin: 0; font-size: 14.5px; line-height: 1.45; opacity: .72; }

  /* Oscura: la 04 por defecto. */
  .step:last-child { background: var(--dark); color: var(--bg); }
  .step:last-child .n { color: #A7A7AC; }

  @media (hover: hover) {
    .step { transition: background-color .3s, color .3s, transform .3s cubic-bezier(.4, 0, .2, 1); }
    .n { transition: color .3s; }
    .step:hover { background: var(--dark); color: var(--bg); transform: translateY(-4px); }
    .step:hover .n { color: #9FBEFF; }
    .steps:has(.step:hover) .step:last-child:not(:hover) { background: var(--bg); color: var(--ink); }
    .steps:has(.step:hover) .step:last-child:not(:hover) .n { color: var(--muted); }
  }
  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    .step, .n { transition: none; }
    .step:hover { transform: none; }
  }
</style>
