---
// «Pensado para cómo opera tu industria» (spec 002 §4.1.6 y §3.5, Inv §1.6). Tabs APG con activación manual;
// cada panel es completo (foto, título, blurb y link a su industria). Sin JS: sólo el panel inicial, sin control.
import { Picture } from 'astro:assets';
import Container from '../../ui/Container.astro';
import CardBig from '../../ui/CardBig.astro';
import Mark from '../../Mark.astro';
import { href, INDUSTRY_SLUGS, type IndustryId, type Locale } from '../../../i18n/routes';
import { industries, industryPhotos } from '../../../content/industries';
import { home } from '../../../content/pages/home';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = home[locale].industries;
const INITIAL: IndustryId = 'manufactura'; // D7
const ids = Object.keys(INDUSTRY_SLUGS) as IndustryId[];
// §3.5: ancho real del visor (CONT + CARD-BIG + 1 px de borde por lado; máximo 1014,4 px).
const SIZES = '(min-width: 1583px) 1015px, (min-width: 1391px) calc(1106px - 5.8vw), (min-width: 1200px) calc(1198px - 12.4vw), (min-width: 1000px) calc(87.6vw - 2px), (min-width: 452px) calc(94.2vw - 34px), calc(100vw - 61px)';
---
<Container gap="clamp(13.1px,1.6vw,19.7px)">
  <CardBig>
    <div class="ind" data-tabs>
      <h2 class="h2 title">{t.h2}</h2>
      <p class="lead">{t.lead}</p>
      <div class="seg" data-tablist aria-label={t.tablist} hidden>
        {ids.map((id) => (
          <button type="button" id={`ind-tab-${id}`} data-tab={`ind-panel-${id}`}>{industries[id][locale].short}</button>
        ))}
      </div>
      <div class="viewer">
        {ids.map((id) => {
          const ind = industries[id][locale];
          const photo = industryPhotos[id];
          return (
            <div id={`ind-panel-${id}`} class="panel" data-photo hidden={id !== INITIAL}>
              {photo && (
                <Picture
                  src={photo.src}
                  alt={photo.alt[locale]}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[480, 768, 1080, 1440, 1920]}
                  sizes={SIZES}
                  quality={70}
                  loading="lazy"
                  decoding="async"
                  class="photo"
                />
              )}
              <div class:list={['fallback', { solo: !photo }]} role="img" aria-label={ind.label}>
                <Mark fg="#F4F4F2" core="#3D7BFF" size={44} />
              </div>
              <div class="overlay">
                <div class="txt">
                  <h3>{ind.label}</h3>
                  <p>{ind.blurb}</p>
                </div>
                <a class="more" href={href({ id: 'industria', industry: id }, locale)}>
                  {t.more}<span class="sr-only"> {t.moreAbout} {ind.label}</span> <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </CardBig>
</Container>

<script>
  import { initTabs } from '../../../scripts/tabs';
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) initTabs(root);
</script>

<style>
  .ind { display: flex; flex-direction: column; align-items: center; gap: 22px; }
  .title { text-align: center; max-width: 17ch; }
  .lead { margin: 0; font-size: 16px; color: var(--muted); text-align: center; max-width: 52ch; }

  .seg {
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: #ECECE8;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    margin-top: 6px;
  }
  .seg[hidden] { display: none; }
  .seg button {
    appearance: none;
    border: 0;
    margin: 0;
    flex: none;
    cursor: pointer;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.55;
    background: transparent;
    color: var(--muted);
  }
  .seg button:focus-visible { outline-offset: -2px; }
  .seg button[aria-selected='true'] { background: var(--white); color: var(--ink); box-shadow: 0 1px 2px rgba(11, 11, 12, .08); }

  .viewer {
    position: relative;
    width: 100%;
    margin-top: 14px;
    border-radius: clamp(16.4px, 2.1vw, 26.2px);
    overflow: hidden;
    background: #3A3A3C;
    height: clamp(344.4px, 34.4vw, 492px);
  }
  .panel { position: absolute; inset: 0; }
  .panel[hidden] { display: none; }
  .panel:focus-visible { outline: 2px solid var(--blue-link); outline-offset: -2px; box-shadow: inset 0 0 0 4px var(--white); }
  .panel :global(.photo) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Respaldo: siempre para photo === null; para una foto, sólo si su carga falló. */
  .fallback { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; padding-bottom: 96px; }
  .fallback.solo, [data-failed] .fallback { display: flex; }
  [data-failed] :global(picture) { display: none; }

  .overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: clamp(18px, 2.5vw, 36.1px);
    background: linear-gradient(180deg, rgba(20, 20, 22, 0), rgba(20, 20, 22, .88) 55%);
    color: var(--white);
    display: flex;
    flex-wrap: wrap;
    gap: 20px 40px;
    align-items: flex-end;
    justify-content: space-between;
  }
  .txt { display: flex; flex-direction: column; gap: 10px; max-width: 56ch; }
  h3 { margin: 0; font-size: clamp(23px, 2.5vw, 36.1px); font-weight: 500; letter-spacing: -.04em; line-height: 1.05; }
  .txt p { margin: 0; font-size: 15px; line-height: 1.5; color: #E4E4E0; }
  .more {
    padding: 15px 24px;
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--ink);
    font-size: 16px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color .15s ease;
  }
  .more:hover { background: var(--surface-3); color: var(--ink); }
  .more:focus-visible { outline-color: var(--white); }
</style>
