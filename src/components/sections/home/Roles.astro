---
// «Toda la empresa puede preguntar» (spec 002 §4.1.3, Inv §1.3). El selector de rol y el panel de permisos los dibuja la isla (spec 003 §4.4).
import Container from '../../ui/Container.astro';
import HeadRow from '../../ui/HeadRow.astro';
import AppSlot from '../../ui/AppSlot.astro';
import { href, type Locale } from '../../../i18n/routes';
import { home } from '../../../content/pages/home';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = home[locale].roles;
---
<Container gap="L" class="roles">
  <HeadRow>
    <h2 class="h2">{t.h2}</h2>
    <Fragment slot="lead">{t.lead}</Fragment>
  </HeadRow>
  <AppSlot view="cerebro" locale={locale} contactHref={href({ id: 'hablemos' }, locale)} frame="none" variant="role-demo" />
  <p class="note"><span class="dot" aria-hidden="true"></span>{t.note}</p>
</Container>

<style>
  .roles { display: flex; flex-direction: column; gap: 28px; }
  .note {
    margin: 0;
    display: flex;
    gap: 10px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: .02em;
    color: var(--body-2);
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--blue); flex: none; }
</style>
