---
// Capacidades (spec 002 §4.1.4, Inv §1.4): ejemplo siempre visible; hover sólo con puntero que lo soporte.
import Container from '../../ui/Container.astro';
import Kicker from '../../ui/Kicker.astro';
import Txt from './Txt.astro';
import { href, type Locale } from '../../../i18n/routes';
import { home } from '../../../content/pages/home';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = home[locale].capabilities;
---
<Container gap="L" class="caps">
  <div class="head">
    <Kicker>{t.kicker}</Kicker>
    <h2 class="h2"><Txt text={t.h2} /></h2>
  </div>
  <ul class="grid">
    {t.items.map((c) => (
      <li class="card">
        <span class="n">{c.n}</span>
        <h3>{c.t}</h3>
        <p class="d">{c.d}</p>
        <p class="ex"><span class="bullet" aria-hidden="true"></span>{c.ex}</p>
      </li>
    ))}
  </ul>
  <a class="wide" href={href({ id: 'producto' }, locale, 'agentes')}>
    <span><Txt text={t.cta} /></span><span class="arrow" aria-hidden="true">→</span>
  </a>
</Container>

<style>
  .caps { display: flex; flex-direction: column; gap: 28px; }
  .head { display: flex; flex-direction: column; gap: 14px; }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 12px;
  }
  .card {
    background: var(--white);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 22px;
    min-height: 213px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .n { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
  h3 { margin: auto 0 0; font-size: 30px; font-weight: 500; letter-spacing: -.045em; line-height: 1; }
  .d { margin: 0; font-size: 16px; color: var(--muted); max-width: 28ch; }
  /* §4.1.4: en reposo --body-2 sobre blanco con borde --line; en hover #D9D9DC sobre negro con borde #2A2A2E. */
  .ex {
    margin: 0;
    display: flex;
    gap: 8px;
    align-items: baseline;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.45;
    color: var(--body-2);
  }
  .bullet { width: 6px; height: 6px; border-radius: 50%; background: var(--blue-light); flex: none; transform: translateY(-1px); }

  @media (hover: hover) {
    .card, .n, .d, .ex { transition: background-color .3s, color .3s, border-color .3s; }
    .card { transition: background-color .3s, color .3s, border-color .3s, transform .3s cubic-bezier(.4, 0, .2, 1); }
    .card:hover { background: var(--dark); color: var(--bg); border-color: var(--dark); transform: translateY(-4px); }
    .card:hover .n { color: #9FBEFF; }
    .card:hover .d { color: #A7A7AC; }
    .card:hover .ex { color: #D9D9DC; border-top-color: #2A2A2E; }
  }
  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    .card, .n, .d, .ex { transition: none; }
    .card:hover { transform: none; }
  }

  .wide {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 28px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color .15s ease;
  }
  .wide:hover { background: #DCDCD7; color: var(--ink); }
  .arrow { flex: none; }
</style>
