---
import { href, type Locale, type PageRef } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  /** La página actual: el selector lleva a su equivalente en el otro idioma. null en la 404 (sin selector). */
  page: PageRef | null;
  locale: Locale;
  class?: string;
  /** 'pill': píldora de dos opciones para la cápsula del header de escritorio (spec 006 §3.1). */
  variant?: 'inline' | 'pill';
}
const { page, locale: currentLocale, variant = 'inline' } = Astro.props;
const current = page ? { page, locale: currentLocale } : null;
const LOCALES: Locale[] = ['es', 'en'];
---
{current && variant === 'pill' && (
  <span class:list={['pill', Astro.props.class]}>
    {LOCALES.map((locale) => (
      <a
        class="opt"
        href={href(current.page, locale)}
        hreflang={locale}
        lang={locale}
        aria-label={ui[current.locale].nav.langName[locale]}
        aria-current={locale === current.locale ? 'true' : undefined}
      >{locale.toUpperCase()}</a>
    ))}
  </span>
)}
{current && variant === 'inline' && (
  <span class:list={['lang', Astro.props.class]}>
    {LOCALES.map((locale, i) => (
      <>
        {i > 0 && <span aria-hidden="true">·</span>}
        {locale === current.locale ? (
          <span aria-current="true">{locale.toUpperCase()}</span>
        ) : (
          <a
            href={href(current.page, locale)}
            tabindex="0"
            hreflang={locale}
            lang={locale}
            aria-label={ui[current.locale].nav.langName[locale]}
          >{locale.toUpperCase()}</a>
        )}
      </>
    ))}
  </span>
)}

<style>
  .lang { display: inline-flex; gap: 6px; align-items: center; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  [aria-current] { color: var(--ink); }

  /* Píldora del header (diseño de Nacho: padding 3, opciones 6×10, mono 12). Cada opción mide 44 px de alto de área
     táctil sin agrandar la píldora: el padding vertical se descuenta con margen negativo y el fondo del actual se
     dibuja con ::before al tamaño visual. */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, .35);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .02em;
  }
  .opt {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-block: -9px;
    padding-inline: 10px;
    border-radius: var(--radius-pill);
    color: var(--ink);
    text-decoration: none;
    transition: color .15s ease;
  }
  .opt::before {
    content: '';
    position: absolute;
    inset: 9px 0;
    z-index: -1;
    border-radius: inherit;
    background: transparent;
    transition: background-color .15s ease;
  }
  .opt[aria-current] { color: var(--white); }
  .opt[aria-current]::before { background: var(--ink); }
  .opt:not([aria-current]):hover { text-decoration: none; }
  .opt:not([aria-current]):hover::before { background: rgba(11, 11, 12, .08); }
  .opt:focus-visible { outline: 2px solid var(--blue-link); outline-offset: -4px; }
</style>
